{
  "name": "@marsbasex/fea",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "bin": {
    "fea": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/build.mjs",
    "demo:check": "node demo/check.mjs",
    "arena:demo": "node demo/arena.mjs",
    "auth:demo": "node demo/auth.mjs",
    "mcp:demo": "node demo/mcp.mjs",
    "arena:import-demo": "node demo/external-fixture.mjs",
    "protect:demo": "node demo/protect.mjs",
    "sarif:demo": "node demo/sarif.mjs",
    "arena:execute-demo": "node src/cli.mjs arena execute --suite demo/arena-suite.json --baseline demo/generated/baseline/app.asar --hardened demo/generated/hardened/app.asar --adapter demo/trusted-observer.mjs --engine demo/arena-executor-engine.json --out demo/generated/reports/arena-execution --i-own-artifacts",
    "release:demo": "node demo/release-readiness.mjs",
    "native:verify": "node scripts/verify-real-electron.mjs",
    "trust:demo": "node demo/release-trust.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:audit-demo": "node demo/release-audit.mjs",
    "distribution:smoke": "node scripts/distribution-smoke.mjs",
    "release:package-audit": "node scripts/package-content-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "files": [
    "src/",
    "assets/fea-icon.png",
    "assets/fea-hero.svg",
    "assets/fea-demo-exposure.svg",
    "docs/",
    "README.md",
    "README.en.md",
    "IMPLEMENTATION.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ]
}
